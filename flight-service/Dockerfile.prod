# Production image for Flight Service (Flask)
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app

EXPOSE 5001

# NOTE: flight-service starts a background Process in create_app(); keep -w 1 to avoid duplicates.
CMD ["gunicorn", "-w", "1", "-b", "0.0.0.0:5001", "app.main:app"]
